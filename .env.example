# DaVinci Resolve scripting bridge (required only for redline_core.resolve.ResolveScriptAdapter).
# See docs/CONFIG.md for OS-specific defaults.
RESOLVE_SCRIPT_API="/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting"
RESOLVE_SCRIPT_LIB="/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so"

# Redline OS paths
REDLINE_DB_PATH="./redline.db"
REDLINE_CONFIG_DIR="./config"
REDLINE_LOG_DIR="./logs"
REDLINE_LOG_LEVEL="INFO"
